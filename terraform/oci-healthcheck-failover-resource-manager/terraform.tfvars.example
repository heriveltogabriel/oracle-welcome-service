region            = "sa-vinhedo-1"
tenancy_ocid      = "ocid1.tenancy.oc1..example"
compartment_ocid  = "ocid1.compartment.oc1..example"
name_prefix       = "healthcheck-failover"

standby_instance_ocid = "ocid1.instance.oc1.sa-vinhedo-1.example"

healthcheck_target   = "167.126.22.81"
healthcheck_path     = "/health-check"
healthcheck_protocol = "HTTP"
healthcheck_port     = 80
# Leave empty to let OCI select vantage points, or use CSV:
# healthcheck_vantage_point_names = "azr-sat,goo-cbf,aws-fra"
healthcheck_vantage_point_names = ""

function_image       = "vcp.ocir.io/<namespace>/failover/start-standby:1.0.0"
function_subnet_ocid = "ocid1.subnet.oc1.sa-vinhedo-1.example"
function_subnet_ocids = ""
function_nsg_ocids    = ""

notification_email = "you@example.com"

# Set this only if the standby VM is in another compartment.
compute_compartment_ocid = ""

# Optional: override if the default Health Checks MQL does not match your tenancy metrics.
alarm_query_override = ""

# Keep false when the stack runs outside the tenancy home region.
# Create the Dynamic Group and Policy manually in the home region after apply.
create_identity_resources = false

# Has effect only when create_identity_resources = true.
# In the tutorial flow, create the equivalent policy manually.
allow_faas_to_read_repos = false
